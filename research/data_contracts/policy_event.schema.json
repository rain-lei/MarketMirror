{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "marketmirror://schema/policy_event_catalog",
  "title": "Policy and market-calendar event catalog",
  "type": "object",
  "required": ["catalog_id", "data_kind", "events"],
  "properties": {
    "catalog_id": {"type": "string", "minLength": 1},
    "data_kind": {"const": "source_verified_context"},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}}
  },
  "additionalProperties": false,
  "$defs": {
    "event": {
      "type": "object",
      "required": ["event_id", "event_class", "title", "source", "publication", "visibility", "effective_period", "scope", "use_policy"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "event_class": {"enum": ["financial_regulation", "regional_public_health", "market_calendar"]},
        "title": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "required": ["source_kind", "publisher", "url", "archive_path", "sha256"],
          "properties": {
            "source_kind": {"enum": ["official_primary", "official_exchange_notice", "news_report_of_official_notice"]},
            "publisher": {"type": "string", "minLength": 1},
            "url": {"type": "string", "format": "uri"},
            "archive_path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "additionalProperties": false
        },
        "publication": {
          "type": "object",
          "required": ["date", "precision", "timestamp"],
          "properties": {
            "date": {"type": "string", "format": "date"},
            "precision": {"enum": ["exact_timestamp", "date_only"]},
            "timestamp": {"type": ["string", "null"]}
          },
          "allOf": [
            {"if": {"properties": {"precision": {"const": "exact_timestamp"}}}, "then": {"properties": {"timestamp": {"type": "string", "format": "date-time"}}}},
            {"if": {"properties": {"precision": {"const": "date_only"}}}, "then": {"properties": {"timestamp": {"type": "null"}}}}
          ],
          "additionalProperties": false
        },
        "visibility": {
          "type": "object",
          "required": ["time_status", "anchor_rule", "sensitivity_rules", "note"],
          "properties": {
            "time_status": {"enum": ["observed_exact_timestamp", "date_only_conservative", "reported_time_unresolved"]},
            "anchor_rule": {"enum": ["source_timestamp_then_exchange_calendar", "publication_date_then_exchange_calendar"]},
            "sensitivity_rules": {"type": "array", "items": {"enum": ["effective_time_upper_bound_proxy"]}},
            "note": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "effective_period": {
          "type": "object",
          "required": ["from", "through", "note"],
          "properties": {
            "from": {"type": ["string", "null"]},
            "through": {"type": ["string", "null"]},
            "note": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "scope": {
          "type": "object",
          "required": ["jurisdiction", "direct_subjects", "issuer_codes", "industry_codes", "mapping_status", "note"],
          "properties": {
            "jurisdiction": {"type": "string", "minLength": 1},
            "direct_subjects": {"type": "array", "items": {"type": "string"}},
            "issuer_codes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{6}$"}},
            "industry_codes": {"type": "array", "items": {"type": "string"}},
            "mapping_status": {"enum": ["unmapped", "partial", "verified"]},
            "note": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "use_policy": {
          "type": "object",
          "required": ["mode", "agent_signal_enabled"],
          "properties": {
            "mode": {"const": "context_only"},
            "agent_signal_enabled": {"const": false}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
